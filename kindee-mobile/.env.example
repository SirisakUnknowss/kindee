# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app: publishable keys only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Deployed Cloudflare Pages app that serves /api/sync, /api/barcode, /api/report, /api/account
EXPO_PUBLIC_API_BASE=https://kindee.pages.dev
EXPO_PUBLIC_PRIVACY_EMAIL=privacy@kindee.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@kindee.app
