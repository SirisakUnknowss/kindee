# Cloudflare Pages Functions local config — copy to .dev.vars
# Never commit the real .dev.vars file.
SUPABASE_URL="https://your-local-or-dev-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_development_key"
SUPABASE_SERVICE_ROLE_KEY="your_development_service_role_key"
BARCODE_PROVIDER_URL="https://world.openfoodfacts.org/api/v2/product"
GEMINI_API_KEY="your_development_gemini_key"
GEMINI_MODEL="gemini-3.6-flash"
APP_URL="http://localhost:8788"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
STRIPE_PRICE_PLUS_MONTH="price_plus_month"
STRIPE_PRICE_PLUS_YEAR="price_plus_year"
STRIPE_PRICE_PRO_MONTH="price_pro_month"
STRIPE_PRICE_PRO_YEAR="price_pro_year"
STRIPE_PRICE_UNLIMITED_MONTH="price_unlimited_month"
STRIPE_PRICE_UNLIMITED_YEAR="price_unlimited_year"
