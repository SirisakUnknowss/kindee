# Vite client config — copy to .env.production.local for a manual production build.
# For Cloudflare Git deploys, set the same values in the Production environment.
VITE_APP_ENV=production
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_production_key
