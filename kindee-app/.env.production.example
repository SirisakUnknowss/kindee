# Vite client config — copy to .env.production.local for a manual production build.
# For Cloudflare Git deploys, set the same values in the Production environment.
VITE_APP_ENV=production
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_production_key
VITE_ADMIN_SUPABASE_URL=https://your-separate-admin-production-project.supabase.co
VITE_ADMIN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_admin_production_key
VITE_DATA_CONTROLLER_NAME=ชื่อบุคคลหรือนิติบุคคลผู้ควบคุมข้อมูล
VITE_DATA_CONTROLLER_ADDRESS=ที่อยู่สำหรับติดต่อผู้ควบคุมข้อมูล
VITE_PRIVACY_EMAIL=privacy@your-domain.example
VITE_SUPPORT_EMAIL=support@your-domain.example
